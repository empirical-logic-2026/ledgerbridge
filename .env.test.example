# LedgerBridge — test environment (LedgerBridge Test Co).
# Copy to .env.test and fill in values. Never commit .env.test.

APP_ENV=test
AUTH_MODE=local

# MySQL (compose project: ledgerbridge-test)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_APP_USER=app_rw
MYSQL_APP_PASSWORD=change-me-app

# Host ports (bound to 127.0.0.1)
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
QDRANT_HOST_PORT=6333
API_HOST_PORT=8001

# Service URLs as seen from the host. Containers override these in deploy/compose.yaml.
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6333

# Tally XML server on the Windows host (containers use host.docker.internal; see compose.yaml)
TALLY_URL=http://localhost:9000

# AI provider: Anthropic API is allowed for test data only
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Used from M5 onwards; leave empty for now
TOKEN_SIGNING_KEY=
CREDENTIALS_ENC_KEY=

FRONTEND_ORIGIN=http://localhost:5175
