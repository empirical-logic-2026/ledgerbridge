# LedgerBridge — pilot environment (client backup companies).
# Run by the developer only. Claude Code must never create or use .env.pilot.
# Copy to .env.pilot and fill in values. Never commit .env.pilot.

APP_ENV=pilot
AUTH_MODE=local

# MySQL (compose project: ledgerbridge-pilot)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3317
MYSQL_APP_USER=app_rw
MYSQL_APP_PASSWORD=change-me-app

# Host ports (bound to 127.0.0.1); different from test so both can run side by side
MYSQL_HOST_PORT=3317
REDIS_HOST_PORT=6390
QDRANT_HOST_PORT=6343
API_HOST_PORT=8010

# Service URLs as seen from the host. Containers override these in deploy/compose.yaml.
REDIS_URL=redis://127.0.0.1:6390/0
QDRANT_URL=http://127.0.0.1:6343

# Tally XML server on the Windows host
TALLY_URL=http://host.docker.internal:9000

# AI provider: client data uses a local model only (PIL-005). anthropic is rejected here.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Used from M5 onwards; leave empty for now
TOKEN_SIGNING_KEY=
CREDENTIALS_ENC_KEY=

FRONTEND_ORIGIN=http://localhost:5174
